# ---------------------------------------------------------------------------
# NNM frontend environment configuration
# Copy to `.env` (or `.env.local`) and adjust.
# ---------------------------------------------------------------------------

# Base URL the browser uses for API calls.
# Leave as /api in development: vite proxies it to the backend (see below).
VITE_API_BASE_URL=/api

# Where the vite dev-server proxy forwards /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000
