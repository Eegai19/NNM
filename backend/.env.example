# ---------------------------------------------------------------------------
# NNM backend environment configuration
# Copy to `.env` and adjust for your environment.
# ---------------------------------------------------------------------------

# Application
NNM_PROJECT_NAME="NNM - Nokia Node Manager"
NNM_ENVIRONMENT=development
NNM_DEBUG=true

# Security -- CHANGE THIS IN PRODUCTION
NNM_SECRET_KEY=change-me-to-a-long-random-string
NNM_ALGORITHM=HS256
NNM_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# SQLite (default)
NNM_DATABASE_URL=sqlite:///./nnm.db
# PostgreSQL (later migration)
# NNM_DATABASE_URL=postgresql+psycopg://nnm:nnm@localhost:5432/nnm

# File storage
NNM_STORAGE_DIR=./storage/activity_logs
NNM_MAX_UPLOAD_SIZE_MB=25

# CORS -- comma separated list of allowed frontend origins
NNM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap admin (used by scripts/seed.py)
NNM_FIRST_TPM_USERNAME=admin
NNM_FIRST_TPM_PASSWORD=Admin@123
NNM_FIRST_TPM_NAME=System Administrator
NNM_FIRST_TPM_MOBILE=9000000000
